<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>XHS 竞品周报 {{ since }} ~ {{ until }}</title>
<style>
  body { font-family: "PingFang SC", "Microsoft YaHei", sans-serif; margin: 0; background: #f5f6f8; color: #333; }
  .container { max-width: 1000px; margin: 0 auto; padding: 24px; }
  h1 { font-size: 20px; } h2 { font-size: 16px; margin-top: 32px; border-left: 4px solid #ff2442; padding-left: 10px; }
  .stats { display: flex; gap: 12px; flex-wrap: wrap; }
  .stat { background: #fff; border-radius: 8px; padding: 14px 18px; flex: 1; min-width: 150px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  .stat .label { color: #888; font-size: 12px; } .stat .num { font-size: 24px; font-weight: 700; color: #ff2442; }
  table { width: 100%; border-collapse: collapse; background: #fff; font-size: 13px; }
  th, td { padding: 8px 10px; border-bottom: 1px solid #eee; text-align: left; vertical-align: top; }
  th { background: #fafafa; white-space: nowrap; }
  .rank { color: #ff2442; font-weight: 700; }
  .cb-pair { display: inline-block; background: #fff7e6; color: #d46b08; border: 1px solid #ffd591;
             border-radius: 999px; padding: 1px 10px; font-weight: 600; font-size: 12px; white-space: nowrap; }
  .badge { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; }
  .badge.img { background: #fff1f0; color: #ff2442; } .badge.vid { background: #e6f7ff; color: #1890ff; }
  .meta { color: #888; font-size: 12px; }
  a { color: #1890ff; text-decoration: none; }
  p.meta { margin-top: 40px; }
</style>
</head>
<body>
<div class="container">
  <h1>小红书竞品监测周报（{{ since }} ~ {{ until }}）</h1>

  <div class="stats">
    <div class="stat"><div class="label">本周发布笔记</div><div class="num">{{ notes|length }}</div></div>
    <div class="stat"><div class="label">总点赞</div><div class="num">{{ '{:,}'.format(total_likes) }}</div></div>
    <div class="stat"><div class="label">联名内容</div><div class="num">{{ cobrand_total }}</div></div>
    <div class="stat"><div class="label">监测账号</div><div class="num">{{ accounts|length }}</div></div>
  </div>

  <h2>各账号本周发布</h2>
  <table>
    <tr><th>账号</th><th>发布数</th><th>点赞</th><th>收藏</th><th>联名</th></tr>
    {% for a in accounts %}
    <tr><td>{{ a.nickname }}</td><td><b>{{ a.total }}</b></td>
        <td>{{ '{:,}'.format(a.likes or 0) }}</td><td>{{ '{:,}'.format(a.collects or 0) }}</td>
        <td>{{ a.cobrand_cnt or 0 }}</td></tr>
    {% endfor %}
  </table>

  <h2>本周爆款 Top 10（按点赞）</h2>
  <table>
    <tr><th>#</th><th>标题</th><th>账号</th><th>类型</th><th>点赞</th><th>收藏</th><th>评论</th><th>发布时间</th></tr>
    {% for n in top %}
    <tr><td class="rank">{{ loop.index }}</td>
        <td><a href="{{ n.note_url }}">{{ n.title }}</a>{% if n.cobrand %} <span class="cb-pair">{{ n.cobrand }}</span>{% endif %}</td>
        <td>{{ n.nickname }}</td>
        <td><span class="badge {{ 'vid' if n.note_type == '视频' else 'img' }}">{{ n.note_type }}</span></td>
        <td><b>{{ '{:,}'.format(n.liked_count) }}</b></td>
        <td>{{ '{:,}'.format(n.collected_count) }}</td><td>{{ '{:,}'.format(n.comment_count) }}</td>
        <td class="meta">{{ fmt_ts(n.publish_time) }}</td></tr>
    {% endfor %}
  </table>

  <h2>本周联名内容（{{ cobrand_notes|length }} 篇）</h2>
  {% if cobrand_notes %}
  <table>
    <tr><th>联名</th><th>标题</th><th>账号</th><th>点赞</th><th>发布时间</th></tr>
    {% for n in cobrand_notes %}
    <tr><td><span class="cb-pair">{{ n.cobrand }}</span></td>
        <td><a href="{{ n.note_url }}">{{ n.title }}</a></td>
        <td>{{ n.nickname }}</td><td>{{ '{:,}'.format(n.liked_count) }}</td>
        <td class="meta">{{ fmt_ts(n.publish_time) }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="meta">本周未识别到联名内容。</p>
  {% endif %}

  <h2>本周全部笔记（{{ notes|length }} 篇）</h2>
  <table>
    <tr><th>账号</th><th>标题</th><th>类型</th><th>发布时间</th><th>点赞</th><th>收藏</th><th>评论</th></tr>
    {% for n in notes %}
    <tr><td>{{ n.nickname }}</td>
        <td><a href="{{ n.note_url }}">{{ n.title }}</a>{% if n.cobrand %} <span class="cb-pair">{{ n.cobrand }}</span>{% endif %}</td>
        <td><span class="badge {{ 'vid' if n.note_type == '视频' else 'img' }}">{{ n.note_type }}</span></td>
        <td class="meta">{{ fmt_ts(n.publish_time) }}</td>
        <td>{{ '{:,}'.format(n.liked_count) }}</td><td>{{ '{:,}'.format(n.collected_count) }}</td>
        <td>{{ '{:,}'.format(n.comment_count) }}</td></tr>
    {% endfor %}
  </table>

  <p class="meta">Excel 明细见附件；交互式看板见 data/dashboard.html。由 xhs-monitor 自动生成。</p>
</div>
</body>
</html>
