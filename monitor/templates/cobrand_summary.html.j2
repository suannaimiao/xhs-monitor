<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>联名内容汇总</title>
<style>
  body { font-family: "PingFang SC", "Microsoft YaHei", sans-serif; margin: 0; background: #f5f6f8; color: #333; }
  .container { max-width: 1000px; margin: 0 auto; padding: 24px; }
  h1 { font-size: 20px; } h2 { font-size: 16px; margin-top: 32px; border-left: 4px solid #f59e0b; padding-left: 10px; }
  .stat { background: #fff; border-radius: 8px; padding: 14px 18px; display: inline-block; margin-right: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  .stat .num { font-size: 24px; font-weight: 700; color: #d46b08; }
  .stat .label { color: #888; font-size: 12px; }
  table { width: 100%; border-collapse: collapse; background: #fff; font-size: 13px; }
  th, td { padding: 8px 10px; border-bottom: 1px solid #eee; text-align: left; vertical-align: top; }
  th { background: #fafafa; }
  .cb-pair { display: inline-block; background: #fff7e6; color: #d46b08; border: 1px solid #ffd591;
             border-radius: 999px; padding: 1px 10px; font-weight: 600; font-size: 12px; white-space: nowrap; }
  .meta { color: #888; font-size: 12px; }
  a { color: #1890ff; text-decoration: none; }
</style>
</head>
<body>
<div class="container">
  <h1>小红书联名内容汇总</h1>
  <div>
    <span class="stat"><div class="num">{{ notes|length }}</div><div class="label">联名笔记</div></span>
    <span class="stat"><div class="num">{{ top_pairs|length }}</div><div class="label">联名组合（Top）</div></span>
    <span class="stat"><div class="num">{{ '{:,}'.format(notes|map(attribute='liked_count')|sum) }}</div><div class="label">总点赞</div></span>
  </div>

  <h2>联名组合 Top 20</h2>
  <table>
    <tr><th>#</th><th>联名组合</th><th>笔记数</th></tr>
    {% for pair, cnt in top_pairs %}
    <tr><td>{{ loop.index }}</td><td><span class="cb-pair">{{ pair }}</span></td><td><b>{{ cnt }}</b></td></tr>
    {% endfor %}
  </table>

  <h2>最新 50 篇联名笔记</h2>
  <table>
    <tr><th>联名</th><th>标题</th><th>账号</th><th>点赞</th><th>发布时间</th></tr>
    {% for n in notes[:50] %}
    <tr><td><span class="cb-pair">{{ n.cobrand }}</span></td>
        <td><a href="{{ n.note_url }}">{{ n.title }}</a></td>
        <td>{{ n.nickname }}</td><td>{{ '{:,}'.format(n.liked_count) }}</td>
        <td class="meta">{{ fmt_ts(n.publish_time) }}</td></tr>
    {% endfor %}
  </table>

  <p class="meta">媒体分卷 zip 见各邮件附件；联名专属看板见 dashboard_cobrand.html。由 xhs-monitor 自动生成。</p>
</div>
</body>
</html>
